+/* ------------------------------------------------------------------ */
+/* Talking to the Navidrome plugin                                      */
+/* ------------------------------------------------------------------ */
+
+static PluginHandle * nd_plugin ()
+{
+    return aud_plugin_lookup_basename ("navidrome");
+}
+
+static bool nd_enabled ()
+{
+    PluginHandle * p = nd_plugin ();
+    return p && aud_plugin_get_enabled (p);
+}
+
+static int nd_send (const char * code, const void * data = nullptr)
+{
+    PluginHandle * p = nd_plugin ();
+    return (p && aud_plugin_get_enabled (p)) ? aud_plugin_send_message (p, code, data, 0) : -1;
+}
+
+static const char * const NOT_ENABLED =
+    N_("Turn on Navidrome in Settings > Plugins > General");
+
+/* What the window shows, pulled from the plugin whenever it fires a hook. */
+struct NdPlaylistRow
+{
+    String id, name, count;
+};
+
+static std::vector<NdPlaylistRow> s_playlists;
+static bool s_playlists_loaded = false;
+static bool s_playlists_failed = false;
+static String s_status, s_pl_status, s_order, s_source, s_source_name;
+static bool s_busy = false;
+static bool s_loaded = false; // a Navidrome playlist exists in Audacious
+
+static void pull_from_plugin ()
+{
+    s_playlists.clear ();
+    s_playlists_loaded = s_playlists_failed = false;
+    s_order = s_source = s_source_name = s_pl_status = String ();
+    s_busy = s_loaded = false;
+
+    if (! nd_enabled ())
+    {
+        s_status = String (_(NOT_ENABLED));
+        return;
+    }
+
+    String status;
+    nd_send ("get-status", & status);
+    s_status = status;
+    String pl_status;
+    nd_send ("get-playlist-status", & pl_status);
+    s_pl_status = pl_status;
+
+    Index<String> info;
+    nd_send ("get-info", & info);
+    if (info.len () >= 4)
+    {
+        s_order = info[0];
+        s_source = info[1];
+        s_source_name = info[2];
+        s_busy = info[3] && info[3][0];
+    }
+    if (info.len () >= 5)
+        s_loaded = info[4] && info[4][0];
+
+    Index<String> pls;
+    int got = nd_send ("get-playlists", & pls);
+    s_playlists_loaded = (got == 0);
+    s_playlists_failed = (got == 2);
+    for (int i = 0; i + 2 < pls.len (); i += 3)
+        s_playlists.push_back ({pls[i], pls[i + 1], pls[i + 2]});
+}
+
+/* ------------------------------------------------------------------ */
+/* The button                                                           */
+/* ------------------------------------------------------------------ */
+
+static constexpr int BTN_W = 14, BTN_H = 15;
+
+/* A "N" glyph in the style of the SHUFFLE lettering (5x5). */
+static const char * const glyph[] = {
+    "X...X",
+    "XX..X",
+    "X.X.X",
+    "X..XX",
+    "X...X",
+};
+
+static QImage s_button_image;      // 14x60 custom button (4 states stacked), if provided
+
+static int saturation (QRgb c)
+{
+    int hi = aud::max (qRed (c), aud::max (qGreen (c), qBlue (c)));
+    int lo = aud::min (qRed (c), aud::min (qGreen (c), qBlue (c)));
+    return hi - lo;
+}
+
+/* How the button is drawn, worked out from the skin's Shuffle button when the
+ * skin loads (see navidrome_narrow_shuffle): its bevels, a column of plain
+ * face, how far each state is shifted, and the lettering and LED colours. */
+static QRgb s_glyph_off = qRgb (0x20, 0x20, 0x30), s_glyph_on = qRgb (0x80, 0xff, 0x40);
+static int s_face_x = -1;          // plain face column in SHUFREP (-1 = not known yet)
+static int s_shuf_w = 46;          // Shuffle width after narrowing
+static int s_shift[4] = {0, 0, 0, 0};
+
+/* Your own button art wins over the generated one: put a 14x60 image (rows:
+ * closed, closed+pressed, open, open+pressed, 15 pixels each) at
+ * ~/.config/audacious/navidrome-button.png, or navidrome.bmp/png in the skin. */
+static void load_button_override ()
+{
+    s_button_image = QImage ();
+    StringBuf user = filename_build ({aud_get_path (AudPath::UserDir), "navidrome-button.png"});
+    QImage img;
+    if (g_file_test (user, G_FILE_TEST_EXISTS))
+        img.load ((const char *) user);
+    if (img.isNull ())
+        img = skin.navidrome_button;
+    if (! img.isNull () && img.width () >= BTN_W && img.height () >= BTN_H * 4)
+        s_button_image = img.convertToFormat (QImage::Format_ARGB32);
+}
+
+class NavidromeButton : public Widget
+{
+public:
+    NavidromeButton ()
+    {
+        set_scale (config.scale);
+        add_input (BTN_W, BTN_H, false, true);
+        setToolTip (_("Navidrome"));
+    }
+
+    void set_active (bool active)
+    {
+        m_active = active;
+        queue_draw ();
+    }
+
+private:
+    void draw (QPainter & cr) override;
+    bool button_press (QMouseEvent * event) override;
+    bool button_release (QMouseEvent * event) override;
+
+    bool m_pressed = false, m_active = false;
+};
+
+static NavidromeButton * s_button = nullptr;
+
+void NavidromeButton::draw (QPainter & cr)
+{
+    int row = (m_active ? 30 : 0) + (m_pressed ? 15 : 0);
+
+    if (! s_button_image.isNull ())
+    {
+        cr.drawImage (QRect (0, 0, BTN_W, BTN_H), s_button_image, QRect (0, row, BTN_W, BTN_H));
+        return;
+    }
+
+    // Built from the skin's own Shuffle button: its left bevel, a strip of
+    // plain face, and its right bevel - so it matches whatever skin is loaded.
+    if (s_face_x >= 0)
+    {
+        int state = row / 15;
+        skin_draw_pixbuf (cr, SKIN_SHUFREP, 28, row, 0, 0, 3, BTN_H);
+        for (int x = 3; x < BTN_W - 3; x ++)
+            skin_draw_pixbuf (cr, SKIN_SHUFREP, s_face_x + s_shift[state], row, x, 0, 1, BTN_H);
+        skin_draw_pixbuf (cr, SKIN_SHUFREP, 28 + s_shuf_w - 3, row, BTN_W - 3, 0, 3, BTN_H);
+    }
+    else
+    {
+        skin_draw_pixbuf (cr, SKIN_SHUFREP, 0, row, 0, 0, 3, BTN_H);
+        for (int x = 3; x < BTN_W - 3; x ++)
+            skin_draw_pixbuf (cr, SKIN_SHUFREP, 23, row, x, 0, 1, BTN_H);
+        skin_draw_pixbuf (cr, SKIN_SHUFREP, 25, row, BTN_W - 3, 0, 3, BTN_H);
+    }
+
+    int off = m_pressed ? 1 : 0;
+    cr.setPen (Qt::NoPen);
+    cr.setBrush (QColor (m_active ? s_glyph_on : s_glyph_off));
+    for (int gy = 0; gy < 5; gy ++)
+        for (int gx = 0; gx < 5; gx ++)
+            if (glyph[gy][gx] == 'X')
+                cr.drawRect (4 + gx + off, 5 + gy + off, 1, 1);
+}
+
+bool NavidromeButton::button_press (QMouseEvent * event)
+{
+    if (event->button () != Qt::LeftButton)
+        return false;
+    m_pressed = true;
+    queue_draw ();
+    return true;
+}
+
+bool NavidromeButton::button_release (QMouseEvent * event)
+{
+    if (event->button () != Qt::LeftButton || ! m_pressed)
+        return false;
+    m_pressed = false;
+    if (rect ().contains (event->pos ()))
+        view_set_show_navidrome (! aud_get_bool ("skins", "navidrome_visible"));
+    queue_draw ();
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Narrowing Shuffle to make room                                       */
+/* ------------------------------------------------------------------ */
+
+/* The skin's Shuffle button (46x15, four states stacked in SHUFREP.BMP) is
+ * narrowed by taking out up to 6 columns that only repeat their neighbour:
+ * plain face first (the gaps around the LED and the text), then the doubled
+ * middle column of 4-pixel letters like H and U. Single-pixel gaps between
+ * letters and the LED are never touched, so the lettering stays readable. */
+
+static constexpr int SHUF_X = 28, SHUF_W = 46, SHUF_H = 15, MAX_NARROW = 6;
+static constexpr int IN_L = 3, IN_R = SHUF_W - 3;   // inside the bevels
+
+static int lum (QRgb c) { return (qRed (c) * 3 + qGreen (c) * 6 + qBlue (c)) / 10; }
+
+static bool columns_alike (const QImage & im, int y0, int a, int b)
+{
+    for (int y = 0; y < SHUF_H; y ++)
+    {
+        QRgb p = im.pixel (SHUF_X + a, y0 + y), q = im.pixel (SHUF_X + b, y0 + y);
+        if (abs (qRed (p) - qRed (q)) + abs (qGreen (p) - qGreen (q)) + abs (qBlue (p) - qBlue (q)) > 36)
+            return false;
+    }
+    return true;
+}
+
+/* Which columns carry lettering or the LED: pixels that stand out from the
+ * rest of their row. Rows that are one colour all the way across (bevels,
+ * shading) don't count. */
+static std::vector<bool> ink_columns (const QImage & im, int y0)
+{
+    std::vector<bool> ink (SHUF_W, false);
+    for (int y = 3; y < SHUF_H - 2; y ++)
+    {
+        std::vector<int> row;
+        for (int x = IN_L; x < IN_R; x ++)
+            row.push_back (lum (im.pixel (SHUF_X + x, y0 + y)));
+        std::vector<int> sorted = row;
+        std::nth_element (sorted.begin (), sorted.begin () + sorted.size () / 2, sorted.end ());
+        int median = sorted[sorted.size () / 2];
+        for (int x = IN_L; x < IN_R; x ++)
+            if (abs (row[x - IN_L] - median) > 35)
+                ink[x] = true;
+    }
+    return ink;
+}
+
+/* How far a state's contents are shifted compared with the normal state
+ * (pressed buttons are often drawn 1px to the right). */
+static int state_shift (const std::vector<bool> & base, const std::vector<bool> & other)
+{
+    int best = 0, best_err = INT_MAX;
+    for (int d = -2; d <= 2; d ++)
+    {
+        int err = 0;
+        for (int x = IN_L; x < IN_R; x ++)
+        {
+            int xs = x + d;
+            bool o = (xs >= IN_L && xs < IN_R) ? other[xs] : false;
+            err += (base[x] != o);
+        }
+        if (err < best_err || (err == best_err && abs (d) < abs (best)))
+            best = d, best_err = err;
+    }
+    return best;
+}
+
+int navidrome_narrow_shuffle ()
+{
+    QImage & im = skin.pixmaps[SKIN_SHUFREP];
+    s_face_x = -1;
+    s_shuf_w = SHUF_W;
+    s_glyph_off = qRgb (0x20, 0x20, 0x30);
+    s_glyph_on = qRgb (0x80, 0xff, 0x40);
+    for (int & d : s_shift)
+        d = 0;
+    if (im.width () < SHUF_X + SHUF_W || im.height () < 4 * SHUF_H)
+        return SHUF_W;
+
+    // Runs of look-alike columns in the normal (off) state
+    std::vector<bool> ink = ink_columns (im, 0);
+    struct Run { int start, len; bool face; };
+    std::vector<Run> runs;
+    for (int x = IN_L; x < IN_R; )
+    {
+        int k = x;
+        while (k + 1 < IN_R && columns_alike (im, 0, k + 1, k))
+            k ++;
+        // never touch the LED: any column that changes when Shuffle is turned on
+        bool led = false;
+        for (int i = x; i <= k; i ++)
+            for (int y = 0; y < SHUF_H; y ++)
+                if (im.pixel (SHUF_X + i, y) != im.pixel (SHUF_X + i, 2 * SHUF_H + y))
+                    led = true;
+        if (k > x && ! led)
+        {
+            bool face = true;
+            for (int i = x; i <= k; i ++)
+                face = face && ! ink[i];
+            runs.push_back ({x, k - x + 1, face});
+        }
+        x = k + 1;
+    }
+
+    // Take one column at a time: plain face before letters, longest runs first
+    std::vector<int> drop;
+    while ((int) drop.size () < MAX_NARROW)
+    {
+        int best = -1;
+        for (int i = 0; i < (int) runs.size (); i ++)
+        {
+            if (runs[i].len < 2)
+                continue;
+            if (best < 0 || (runs[i].face && ! runs[best].face) ||
+                (runs[i].face == runs[best].face && runs[i].len > runs[best].len))
+                best = i;
+        }
+        if (best < 0)
+            break;
+        drop.push_back (runs[best].start + runs[best].len - 1);
+        runs[best].len --;
+    }
+    // Colours and face for the Navidrome button, taken before anything moves
+    std::vector<bool> led_col (SHUF_W, false);
+    for (int x = IN_L; x < IN_R; x ++)
+        for (int y = 0; y < SHUF_H; y ++)
+            if (im.pixel (SHUF_X + x, y) != im.pixel (SHUF_X + x, 2 * SHUF_H + y))
+                led_col[x] = true;
+
+    int best_off = -1, best_on = -1;
+    for (int y = 3; y < SHUF_H - 2; y ++)
+    {
+        std::vector<int> row;
+        for (int x = IN_L; x < IN_R; x ++)
+            row.push_back (lum (im.pixel (SHUF_X + x, y)));
+        std::vector<int> sorted = row;
+        std::nth_element (sorted.begin (), sorted.begin () + sorted.size () / 2, sorted.end ());
+        int median = sorted[sorted.size () / 2];
+        for (int x = IN_L; x < IN_R; x ++)
+        {
+            // lettering: the pixel that stands out most from the face, outside the LED
+            int contrast = abs (row[x - IN_L] - median);
+            if (ink[x] && ! led_col[x] && contrast > best_off)
+                best_off = contrast, s_glyph_off = im.pixel (SHUF_X + x, y);
+            // lit LED: the most colourful pixel among the columns that light up
+            QRgb lit = im.pixel (SHUF_X + x, 2 * SHUF_H + y);
+            if (led_col[x] && saturation (lit) > best_on)
+                best_on = saturation (lit), s_glyph_on = lit;
+        }
+    }
+    if (best_off < 0)          // whole button lights up: any lettering will do
+    {
+        for (int y = 3; y < SHUF_H - 2; y ++)
+        {
+            std::vector<int> row;
+            for (int x = IN_L; x < IN_R; x ++)
+                row.push_back (lum (im.pixel (SHUF_X + x, y)));
+            std::vector<int> sorted = row;
+            std::nth_element (sorted.begin (), sorted.begin () + sorted.size () / 2, sorted.end ());
+            int median = sorted[sorted.size () / 2];
+            for (int x = IN_L; x < IN_R; x ++)
+                if (ink[x] && abs (row[x - IN_L] - median) > best_off)
+                    best_off = abs (row[x - IN_L] - median), s_glyph_off = im.pixel (SHUF_X + x, y);
+        }
+    }
+    if (best_on < 40)          // no coloured LED in this skin: keep Winamp green
+        s_glyph_on = qRgb (0x80, 0xff, 0x40);
+
+    int face = -1;      // plain face: no lettering, and not part of the LED...
+    for (int x = IN_L; x < IN_R && face < 0; x ++)
+        if (! ink[x] && ! led_col[x])
+            face = x;
+    for (int x = IN_L; x < IN_R && face < 0; x ++)   // ...or, if the whole button lights up, just no lettering
+        if (! ink[x])
+            face = x;
+    for (int s = 1; s < 4; s ++)
+        s_shift[s] = state_shift (ink, ink_columns (im, s * SHUF_H));
+
+    // Some skins show "on" by recolouring the whole button rather than an LED;
+    // then use the lit lettering, so the N stays readable on the lit face.
+    auto distance = [] (QRgb a, QRgb b) {
+        return abs (qRed (a) - qRed (b)) + abs (qGreen (a) - qGreen (b)) + abs (qBlue (a) - qBlue (b));
+    };
+    if (face >= 0 && distance (s_glyph_on, im.pixel (SHUF_X + face, 2 * SHUF_H + 7)) < 150)
+    {
+        QRgb lit_face = im.pixel (SHUF_X + face, 2 * SHUF_H + 7);
+        int best = -1;
+        for (int y = 3; y < SHUF_H - 2; y ++)
+            for (int x = IN_L; x < IN_R; x ++)
+            {
+                QRgb c = im.pixel (SHUF_X + x, 2 * SHUF_H + y);
+                if (distance (c, lit_face) > best)
+                    best = distance (c, lit_face), s_glyph_on = c;
+            }
+    }
+
+    if (face >= 0)
+    {
+        int before = 0;     // dropped columns left of the face column
+        for (int x : drop)
+            before += (x < face);
+        bool dropped = std::find (drop.begin (), drop.end (), face) != drop.end ();
+        s_face_x = SHUF_X + face - before - (dropped ? 1 : 0);
+    }
+    s_shuf_w = SHUF_W - (int) drop.size ();
+
+    if (drop.empty ())
+        return SHUF_W;
+
+    // Remove the same columns from all four states, allowing for any shift
+    for (int s = 0; s < 4; s ++)
+    {
+        int y0 = s * SHUF_H;
+        int d = s_shift[s];
+        QImage strip = im.copy (SHUF_X, y0, SHUF_W, SHUF_H);
+        int out = 0;
+        for (int x = 0; x < SHUF_W; x ++)
+        {
+            if (std::find (drop.begin (), drop.end (), x - d) != drop.end ())
+                continue;
+            for (int y = 0; y < SHUF_H; y ++)
+                im.setPixel (SHUF_X + out, y0 + y, strip.pixel (x, y));
+            out ++;
+        }
+    }
+
+    return SHUF_W - (int) drop.size ();
+}
