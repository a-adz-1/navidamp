+/* ------------------------------------------------------------------ */
+/* GEN.BMP: frame pieces and the bitmap title font                      */
+/* ------------------------------------------------------------------ */
+
+static constexpr int WIN_W = 275, TOP = 20, BOTTOM = 14, LEFT = 11, RIGHT = 8;
+static constexpr int MIN_H = TOP + 29 + 24 + BOTTOM;   // 87
+static constexpr int STEP_H = 29;
+
+static int snap_height (int h)
+{
+    // the side pieces tile in 29px steps, with a 24px piece at the bottom
+    int k = aud::max (1, (h - TOP - 24 - BOTTOM + STEP_H / 2) / STEP_H);
+    return TOP + STEP_H * k + 24 + BOTTOM;
+}
+
+struct GenLetter
+{
+    int x, w;
+};
+
+static GenLetter s_letters[26];
+static bool s_have_letters = false;
+
+static bool have_gen ()
+{
+    return skin.gen.width () >= 194 && skin.gen.height () >= 103;
+}
+
+/* The letters A-Z sit on two rows (focused / unfocused), separated by
+ * columns of the sheet's background colour. */
+static void scan_gen_letters ()
+{
+    s_have_letters = false;
+    if (! have_gen ())
+        return;
+
+    const QImage & im = skin.gen;
+    QRgb bg = im.pixel (im.width () - 1, 88);
+    std::vector<GenLetter> runs;
+    int start = -1;
+    for (int x = 0; x <= im.width (); x ++)
+    {
+        bool ink = false;
+        if (x < im.width ())
+            for (int y = 88; y < 95; y ++)
+                if (im.pixel (x, y) != bg)
+                    ink = true;
+        if (ink && start < 0)
+            start = x;
+        else if (! ink && start >= 0)
+        {
+            runs.push_back ({start, x - start});
+            start = -1;
+        }
+    }
+
+    // Some skins leave out a separator (Winamp_Classic_CM runs X and Y
+    // together), so split the widest run until there are 26 letters.
+    while (runs.size () > 0 && runs.size () < 26)
+    {
+        auto widest = std::max_element (runs.begin (), runs.end (),
+            [] (const GenLetter & a, const GenLetter & b) { return a.w < b.w; });
+        if (widest->w < 6)
+            break;
+        GenLetter right = {widest->x + widest->w / 2, widest->w - widest->w / 2};
+        widest->w /= 2;
+        runs.insert (widest + 1, right);
+    }
+
+    if (runs.size () < 26)
+        return;
+    for (int i = 0; i < 26; i ++)
+        s_letters[i] = runs[i];
+    s_have_letters = true;
+}
+
+static int gen_text_width (const char * text)
+{
+    int w = 0;
+    for (const char * c = text; * c; c ++)
+    {
+        if (* c >= 'A' && * c <= 'Z')
+            w += s_letters[* c - 'A'].w + 1;
+        else
+            w += 5;
+    }
+    return w > 0 ? w - 1 : 0;
+}
+
+static void gen_draw (QPainter & cr, int sx, int sy, int dx, int dy, int w, int h)
+{
+    cr.drawImage (QRect (dx, dy, w, h), skin.gen, QRect (sx, sy, w, h));
+}
+
+static void gen_draw_text (QPainter & cr, const char * text, int x, int y, bool focused)
+{
+    int sy = focused ? 88 : 96;
+    for (const char * c = text; * c; c ++)
+    {
+        if (* c >= 'A' && * c <= 'Z')
+        {
+            const GenLetter & l = s_letters[* c - 'A'];
+            gen_draw (cr, l.x, sy, x, y, l.w, 7);
+            x += l.w + 1;
+        }
+        else
+            x += 5;
+    }
+}
+
+static const char * const TITLE = "NAVIDROME";
+
+static void draw_gen_frame (QPainter & cr, int h, bool focused, bool close_pressed)
+{
+    int ty = focused ? 0 : 21;
+
+    // title bar: corners, fill, and a plain centre block behind the title
+    for (int x = 25; x < WIN_W - 25; x += 25)
+        gen_draw (cr, 104, ty, x, 0, aud::min (25, WIN_W - 25 - x), TOP);
+    gen_draw (cr, 0, ty, 0, 0, 25, TOP);
+    gen_draw (cr, 130, ty, WIN_W - 25, 0, 25, TOP);
+
+    int tw = s_have_letters ? gen_text_width (TITLE) : 60;
+    int tx = (WIN_W - tw) / 2;
+    gen_draw (cr, 26, ty, tx - 25, 0, 25, TOP);
+    for (int x = tx; x < tx + tw; x += 25)
+        gen_draw (cr, 52, ty, x, 0, aud::min (25, tx + tw - x), TOP);
+    gen_draw (cr, 78, ty, tx + tw, 0, 25, TOP);
+
+    if (s_have_letters)
+        gen_draw_text (cr, TITLE, tx, 4, focused);
+
+    if (close_pressed)
+        gen_draw (cr, 148, 42, WIN_W - 11, 3, 9, 9);
+
+    // sides
+    int side_end = h - BOTTOM - 24;
+    for (int y = TOP; y < side_end; y += STEP_H)
+    {
+        int ph = aud::min (STEP_H, side_end - y);
+        gen_draw (cr, 127, 42, 0, y, LEFT, ph);
+        gen_draw (cr, 139, 42, WIN_W - RIGHT, y, RIGHT, ph);
+    }
+    gen_draw (cr, 158, 42, 0, side_end, LEFT, 24);
+    gen_draw (cr, 170, 42, WIN_W - RIGHT, side_end, RIGHT, 24);
+
+    // bottom
+    for (int x = 125; x < WIN_W - 125; x += 25)
+        gen_draw (cr, 127, 72, x, h - BOTTOM, aud::min (25, WIN_W - 125 - x), BOTTOM);
+    gen_draw (cr, 0, 42, 0, h - BOTTOM, 125, BOTTOM);
+    gen_draw (cr, 0, 57, WIN_W - 125, h - BOTTOM, 125, BOTTOM);
+}
+
+/* For skins without GEN.BMP: a plain frame in the playlist colours. */
+static void draw_plain_frame (QPainter & cr, int h, bool focused, const QFont & font)
+{
+    QColor fg (skin.colors[SKIN_PLEDIT_NORMAL]), bg (skin.colors[SKIN_PLEDIT_NORMALBG]);
+    cr.fillRect (0, 0, WIN_W, h, bg);
+    cr.setPen (fg);
+    cr.drawRect (0, 0, WIN_W - 1, h - 1);
+    cr.drawLine (0, TOP - 1, WIN_W, TOP - 1);
+    cr.drawLine (0, h - BOTTOM, WIN_W, h - BOTTOM);
+    cr.setFont (font);
+    cr.drawText (QRect (0, 0, WIN_W, TOP - 1), Qt::AlignCenter,
+                 focused ? QString ("NAVIDROME") : QString ("navidrome"));
+    cr.drawText (QRect (WIN_W - 14, 0, 12, TOP - 1), Qt::AlignCenter, "x");
+}
+
+/* ------------------------------------------------------------------ */
+/* The window                                                           */
+/* ------------------------------------------------------------------ */
+
+enum { ROW_SHUFFLE, ROW_REFRESH, ROW_REFRESH_PL, ROW_SETTINGS, ROW_HEADER, ROW_FIRST_PLAYLIST };
+
+static const struct { const char * key, * label; } orders[] = {
+    {"folder", N_("by folder")},
+    {"artist", N_("by artist")},
+    {"title", N_("by title")},
+    {"random", N_("scrambled")},
+};
+
+static int order_index (const char * key)
+{
+    for (int i = 0; i < 4; i ++)
+        if (key && ! strcmp (key, orders[i].key))
+            return i;
+    return 0;
+}
+
+class NavidromeWindow : public Window
+{
+public:
+    NavidromeWindow (int h) :
+        Window (WINDOW_NAVIDROME, & config.navidrome_x, & config.navidrome_y, WIN_W, h, false),
+        m_height (h)
+    {
+        update_font ();
+    }
+
+    void update_font ()
+    {
+        m_font = audqt::qfont_from_string (aud_get_str ("skins", "playlist_font"));
+        m_row_h = aud::max (8, QFontMetrics (m_font).height ());
+    }
+
+    void set_height (int h);
+    int height_px () const { return m_height; }
+
+private:
+    void draw (QPainter & cr) override;
+    bool button_press (QMouseEvent * event) override;
+    bool button_release (QMouseEvent * event) override;
+    bool motion (QMouseEvent * event) override;
+    bool scroll (QWheelEvent * event) override;
+    bool leave () override;
+
+    int rows () const { return (m_height - TOP - BOTTOM) / m_row_h; }
+    int playlist_rows () const { return aud::max (0, rows () - ROW_FIRST_PLAYLIST); }
+    int row_at (int x, int y) const;
+    int order_x () const;
+    void clamp_scroll ();
+
+    int m_height;
+    QFont m_font;
+    int m_row_h = 12;
+    int m_scroll = 0;
+    int m_hover = -1, m_pressed_row = -1;
+    bool m_close_pressed = false;
+};
+
+Window * navidromewin;
+static DragHandle * s_resize_handle;
+
+void NavidromeWindow::set_height (int h)
+{
+    m_height = h;
+    resize (WIN_W, h);
+    move_widget (false, s_resize_handle, WIN_W - 20, h - 20);
+    clamp_scroll ();
+    queue_draw ();
+}
+
+void NavidromeWindow::clamp_scroll ()
+{
+    int max_scroll = aud::max (0, (int) s_playlists.size () - playlist_rows ());
+    m_scroll = aud::clamp (m_scroll, 0, max_scroll);
+}
+
+int NavidromeWindow::row_at (int x, int y) const
+{
+    if (x < LEFT || x >= WIN_W - RIGHT || y < TOP || y >= m_height - BOTTOM)
+        return -1;
+    int r = (y - TOP) / m_row_h;
+    return r < rows () ? r : -1;
+}
+
+int NavidromeWindow::order_x () const
+{
+    QFontMetrics fm (m_font);
+    QString label = QString (_(orders[order_index (s_order)].label)) + " >";
+    return WIN_W - RIGHT - 3 - fm.horizontalAdvance (label);
+}
+
+void NavidromeWindow::draw (QPainter & cr)
+{
+    bool focused = is_focused ();
+    QColor normal (skin.colors[SKIN_PLEDIT_NORMAL]);
+    QColor current (skin.colors[SKIN_PLEDIT_CURRENT]);
+    QColor normal_bg (skin.colors[SKIN_PLEDIT_NORMALBG]);
+    QColor selected_bg (skin.colors[SKIN_PLEDIT_SELECTEDBG]);
+    QColor dim ((normal.red () + normal_bg.red ()) / 2,
+                (normal.green () + normal_bg.green ()) / 2,
+                (normal.blue () + normal_bg.blue ()) / 2);
+
+    if (have_gen ())
+        draw_gen_frame (cr, m_height, focused, m_close_pressed);
+    else
+        draw_plain_frame (cr, m_height, focused, m_font);
+
+    QRect content (LEFT, TOP, WIN_W - LEFT - RIGHT, m_height - TOP - BOTTOM);
+    cr.fillRect (content, normal_bg);
+    cr.setClipRect (content);
+    cr.setFont (m_font);
+    QFontMetrics fm (m_font);
+
+    auto text_row = [&] (int r, const QString & left, const QString & right,
+                         const QColor & colour, bool highlight) {
+        QRect row (LEFT, TOP + r * m_row_h, content.width (), m_row_h);
+        if (highlight)
+            cr.fillRect (row, selected_bg);
+        cr.setPen (colour);
+        QRect inner = row.adjusted (3, 0, -3, 0);
+        // short labels ("Refresh") always show in full; long ones (playlist
+        // names) give way to the count on the right; status text is trimmed
+        int left_full = fm.horizontalAdvance (left);
+        int right_full = right.isEmpty () ? 0 : fm.horizontalAdvance (right);
+        int left_w = aud::min (left_full + 2, aud::max (inner.width () / 2, inner.width () - right_full - 8));
+        int right_w = aud::max (0, inner.width () - left_w - 8);
+        if (! right.isEmpty ())
+            cr.drawText (inner, Qt::AlignRight | Qt::AlignVCenter,
+                         fm.elidedText (right, Qt::ElideRight, right_w));
+        cr.drawText (QRect (inner.x (), inner.y (), left_w, inner.height ()),
+                     Qt::AlignLeft | Qt::AlignVCenter, fm.elidedText (left, Qt::ElideRight, left_w));
+    };
+
+    bool library_loaded = s_loaded && s_source && ! s_source[0];
+    bool enabled = nd_enabled ();
+
+    // Shuffle all
+    QString order_label = QString (_(orders[order_index (s_order)].label)) + " >";
+    text_row (ROW_SHUFFLE, _("Shuffle All Songs"), enabled ? order_label : QString (),
+              library_loaded ? current : normal,
+              m_hover == ROW_SHUFFLE || m_pressed_row == ROW_SHUFFLE);
+
+    // Refresh, with the status on the right
+    // Refresh rows, each with what its last run did (and when) on the right
+    text_row (ROW_REFRESH, _("Refresh Library"), s_status ? QString (s_status) : QString (), normal,
+              m_hover == ROW_REFRESH || m_pressed_row == ROW_REFRESH);
+    text_row (ROW_REFRESH_PL, _("Refresh Playlists"), s_pl_status ? QString (s_pl_status) : QString (),
+              normal, m_hover == ROW_REFRESH_PL || m_pressed_row == ROW_REFRESH_PL);
+
+    // Server settings, with the server it's pointed at on the right
+    QString server = QString ((const char *) aud_get_str ("navidrome", "url"));
+    server.remove (QRegularExpression ("^https?://")).remove (QRegularExpression ("/+$"));
+    text_row (ROW_SETTINGS, _("Server Settings"), server.isEmpty () ? QString (_("not set up")) : server,
+              normal, m_hover == ROW_SETTINGS || m_pressed_row == ROW_SETTINGS);
+
+    // Playlists header
+    QString header_right;
+    int n = s_playlists.size ();
+    if (n > playlist_rows ())
+        header_right = QString ("%1-%2 of %3").arg (m_scroll + 1)
+                           .arg (aud::min (n, m_scroll + playlist_rows ())).arg (n);
+    else if (s_playlists_loaded)
+        header_right = QString::number (n);
+    text_row (ROW_HEADER, _("Playlists"), header_right, dim, false);
+    int line_y = TOP + ROW_HEADER * m_row_h + m_row_h - 1;
+    cr.setPen (dim);
+    cr.drawLine (LEFT + 3, line_y, WIN_W - RIGHT - 4, line_y);
+
+    // Playlists
+    if (! enabled)
+        text_row (ROW_FIRST_PLAYLIST, _(NOT_ENABLED), QString (), dim, false);
+    else if (s_playlists_failed)
+    {
+        // the reason, word-wrapped over the rows below
+        text_row (ROW_FIRST_PLAYLIST, _("Couldn't load your playlists:"), QString (), dim, false);
+        QString why = s_pl_status ? QString (s_pl_status) : QString ();
+        why.remove (QRegularExpression ("^Error: "));
+        int width = WIN_W - LEFT - RIGHT - 6, r = ROW_FIRST_PLAYLIST + 1;
+        QString line;
+        for (const QString & word : why.split (' ', Qt::SkipEmptyParts))
+        {
+            QString next = line.isEmpty () ? word : line + ' ' + word;
+            if (fm.horizontalAdvance (next) > width && ! line.isEmpty () && r < rows () - 1)
+            {
+                text_row (r ++, line, QString (), normal, false);
+                next = word;
+            }
+            line = next;
+        }
+        if (! line.isEmpty ())
+            text_row (r, line, QString (), normal, false);
+    }
+    else if (! s_playlists_loaded)
+        text_row (ROW_FIRST_PLAYLIST, _("Loading..."), QString (), dim, false);
+    else if (s_playlists.empty ())
+        text_row (ROW_FIRST_PLAYLIST, _("No playlists on your server"), QString (), dim, false);
+    else
+    {
+        for (int i = 0; i < playlist_rows () && m_scroll + i < n; i ++)
+        {
+            const NdPlaylistRow & p = s_playlists[m_scroll + i];
+            int r = ROW_FIRST_PLAYLIST + i;
+            bool playing = s_source && ! strcmp (s_source, str_concat ({"playlist:", p.id}));
+            text_row (r, QString (p.name), QString (p.count), playing ? current : normal,
+                      m_hover == r || m_pressed_row == r);
+        }
+    }
+
+    cr.setClipping (false);
+}
+
+bool NavidromeWindow::button_press (QMouseEvent * event)
+{
+    int x = QtCompat::x (event) / config.scale, y = QtCompat::y (event) / config.scale;
+
+    if (event->button () == Qt::RightButton && event->type () == QEvent::MouseButtonPress)
+    {
+        menu_popup (UI_MENU_MAIN, QtCompat::globalX (event), QtCompat::globalY (event), false, false);
+        return true;
+    }
+    if (event->button () != Qt::LeftButton)
+        return false;
+
+    if (y < TOP)
+    {
+        if (x >= WIN_W - 12 && x < WIN_W - 1 && y >= 2 && y < 13)
+        {
+            m_close_pressed = true;
+            queue_draw ();
+            return true;
+        }
+        return Window::button_press (event); // drag the window by its title bar
+    }
+
+    if (event->type () == QEvent::MouseButtonDblClick)
+        return true;
+
+    m_pressed_row = row_at (x, y);
+    if (m_pressed_row == ROW_HEADER || m_pressed_row < 0)
+        m_pressed_row = -1;
+    queue_draw ();
+    return true;
+}
+
+bool NavidromeWindow::button_release (QMouseEvent * event)
+{
+    Window::button_release (event);
+    if (event->button () != Qt::LeftButton)
+        return false;
+
+    int x = QtCompat::x (event) / config.scale, y = QtCompat::y (event) / config.scale;
+
+    if (m_close_pressed)
+    {
+        m_close_pressed = false;
+        if (x >= WIN_W - 12 && x < WIN_W - 1 && y >= 2 && y < 13)
+            view_set_show_navidrome (false);
+        queue_draw ();
+        return true;
+    }
+
+    int r = row_at (x, y);
+    int pressed = m_pressed_row;
+    m_pressed_row = -1;
+    queue_draw ();
+
+    if (r < 0 || r != pressed)
+        return true;
+
+    if (r == ROW_SETTINGS)
+    {
+        // the plugin's own settings dialog, or the plugin list if it's turned off
+        if (nd_enabled ())
+            audqt::plugin_prefs (nd_plugin ());
+        else
+            audqt::prefswin_show_plugin_page (PluginType::General);
+        return true;
+    }
+
+    if (! nd_enabled ())
+    {
+        aud_ui_show_error (_("The Navidrome plugin is turned off. Turn it on under "
+                             "Settings > Plugins > General > Navidrome, and set your server there."));
+        return true;
+    }
+
+    if (r == ROW_SHUFFLE)
+    {
+        if (x >= order_x ())
+        {
+            int next = (order_index (s_order) + 1) % 4;
+            nd_send ("set-order", orders[next].key);
+        }
+        else
+            nd_send ("play");
+    }
+    else if (r == ROW_REFRESH_PL)
+        nd_send ("refresh-playlists");
+    else if (r == ROW_REFRESH)
+        nd_send ("refresh");
+    else if (r >= ROW_FIRST_PLAYLIST)
+    {
+        int i = m_scroll + r - ROW_FIRST_PLAYLIST;
+        if (i < (int) s_playlists.size ())
+            nd_send ("play-playlist", (const char *) s_playlists[i].id);
+    }
+    return true;
+}
+
+bool NavidromeWindow::motion (QMouseEvent * event)
+{
+    Window::motion (event); // keeps title-bar dragging working
+
+    int x = QtCompat::x (event) / config.scale, y = QtCompat::y (event) / config.scale;
+    int r = row_at (x, y);
+    if (r == ROW_HEADER || (r >= ROW_FIRST_PLAYLIST && r - ROW_FIRST_PLAYLIST + m_scroll >= (int) s_playlists.size ()))
+        r = -1;
+    if (r != m_hover)
+    {
+        m_hover = r;
+        // the full status, in case it doesn't fit
+        QString tip;
+        if (r == ROW_REFRESH && s_status)
+            tip = QString (s_status);
+        else if (r == ROW_REFRESH_PL && s_pl_status)
+            tip = QString (s_pl_status);
+        setToolTip (tip);
+        queue_draw ();
+    }
+    return true;
+}
+
+bool NavidromeWindow::leave ()
+{
+    if (m_hover >= 0)
+    {
+        m_hover = -1;
+        queue_draw ();
+    }
+    return true;
+}
+
+bool NavidromeWindow::scroll (QWheelEvent * event)
+{
+    int steps = event->angleDelta ().y () / 120;
+    if (! steps)
+        steps = event->angleDelta ().y () > 0 ? 1 : (event->angleDelta ().y () < 0 ? -1 : 0);
+    m_scroll -= steps * 3;
+    clamp_scroll ();
+    queue_draw ();
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Resizing (bottom-right grip, in 29px steps like Winamp)              */
+/* ------------------------------------------------------------------ */
+
+static int s_resize_start_h;
+
+static void resize_press ()
+{
+    s_resize_start_h = ((NavidromeWindow *) navidromewin)->height_px ();
+}
+
+static void resize_drag (int x_offset, int y_offset)
+{
+    auto win = (NavidromeWindow *) navidromewin;
+    int h = snap_height (s_resize_start_h + y_offset);
+    if (h != win->height_px ())
+    {
+        win->set_height (h);
+        aud_set_int ("skins", "navidrome_height", h);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Lifecycle and the view hooks                                         */
+/* ------------------------------------------------------------------ */
+
+static void plugin_changed (void *, void *)
+{
+    pull_from_plugin ();
+    if (navidromewin)
+    {
+        ((NavidromeWindow *) navidromewin)->update_font ();
+        navidromewin->queue_draw ();
+    }
+}
+
+void navidromewin_create ()
+{
+    int h = snap_height (aud::max (MIN_H, aud_get_int ("skins", "navidrome_height")));
+    navidromewin = new NavidromeWindow (h);
+    navidromewin->setWindowTitle (_("Navidrome"));
+    navidromewin->setWindowRole ("navidrome");
+
+    s_resize_handle = new DragHandle (20, 20, resize_press, resize_drag);
+    navidromewin->put_widget (false, s_resize_handle, WIN_W - 20, h - 20);
+
+    hook_associate ("navidrome status", plugin_changed, nullptr);
+    hook_associate ("navidrome playlists", plugin_changed, nullptr);
+    hook_associate ("navidrome source", plugin_changed, nullptr);
+
+    navidromewin_skin_changed ();
+    pull_from_plugin ();
+}
+
+void navidromewin_unhook ()
+{
+    hook_dissociate ("navidrome status", plugin_changed);
+    hook_dissociate ("navidrome playlists", plugin_changed);
+    hook_dissociate ("navidrome source", plugin_changed);
+    s_button = nullptr; // owned and deleted by the main window
+    s_playlists.clear ();
+    s_playlists_loaded = false;
+    s_status = s_pl_status = s_order = s_source = s_source_name = String ();
+}
+
+void navidromewin_skin_changed ()
+{
+    load_button_override ();
+    scan_gen_letters ();
+    if (s_button)
+        s_button->queue_draw ();
+    if (navidromewin)
+    {
+        ((NavidromeWindow *) navidromewin)->update_font ();
+        navidromewin->queue_draw ();
+    }
+}
+
+void view_set_show_navidrome (bool show)
+{
+    aud_set_bool ("skins", "navidrome_visible", show);
+    hook_call ("skins set navidrome_visible", nullptr);
+
+    view_apply_show_navidrome ();
+}
+
+void view_apply_show_navidrome ()
+{
+    bool show = aud_get_bool ("skins", "navidrome_visible");
+
+    if (show && mainwin->isVisible ())
+    {
+        navidromewin->winId ();
+        navidromewin->windowHandle ()->setTransientParent (mainwin->windowHandle ());
+        navidromewin->show ();
+        navidromewin->activateWindow ();
+
+        nd_send ("fetch-playlists"); // only if it isn't already loaded or on its way
+        pull_from_plugin ();
+        navidromewin->queue_draw ();
+    }
+    else
+        navidromewin->hide ();
+
+    navidrome_button_set_active (show);
+}
+
+void navidrome_open_folder ()
+{
+    auto list = Playlist::active_playlist ();
+    int focus = list.get_focus ();
+    String filename = focus >= 0 ? list.entry_filename (focus) : String ();
+
+    if (filename && str_has_prefix_nocase (filename, "navidrome://"))
+    {
+        if (nd_send ("open-in-navidrome", (const char *) filename) != 0)
+            aud_ui_show_error (_("This is a Navidrome track, but the Navidrome plugin is turned off. "
+                                 "Turn it on under Settings > Plugins > General."));
+        return;
+    }
+
+    pl_open_folder ();
+}
